<?xml version="1.0" encoding="utf-8"?>
<!-- Das Backend läuft im Hackathon meist per http im lokalen WLAN → Klartext erlauben. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
