# Vorlage: nach .env kopieren und anpassen  (cp .env.example .env)

# Gemeinsamer Schlüssel mit der Roboter-App (App-Einstellungen → "API-Key")
SR_API_KEY=hinterland-demo

# mock  = Demo ohne Microsoft 365 (Teams-Nachrichten erscheinen im Dashboard)
# smtp  = Demo-Daten, aber Benachrichtigung als echte E-Mail (z. B. Gmail, siehe unten)
# graph = echtes Microsoft 365 über MS Graph
SR_MODE=mock
SR_COMPANY_NAME=Hinterland Hack
SR_TIMEZONE=Europe/Berlin

# Pakete: leave_at_desk (am Empfang ablegen) | wait_for_recipient (Bote wartet auf Empfänger)
# SR_DELIVERY_HANDLING=leave_at_desk

# Arbeitszeiten für Terminvorschläge (im mock-Modus standardmäßig täglich 08–20 Uhr)
# SR_WORK_DAYS=1,2,3,4,5
# SR_WORK_START=09:00
# SR_WORK_END=17:00
# SR_SLOT_MINUTES=30
# SR_SEARCH_DAYS=10
# SR_MAX_SLOTS=3

# ---------------------------------------------------------------------------
# Nur für SR_MODE=smtp  (Gmail: Google-Konto → Sicherheit → 2-Schritt-Bestätigung an
#   → "App-Passwörter" → Passwort erzeugen; NICHT das normale Passwort verwenden)
# ---------------------------------------------------------------------------
# SR_SMTP_HOST=smtp.gmail.com
# SR_SMTP_PORT=587
# SR_SMTP_USER=du@gmail.com
# SR_SMTP_PASSWORD=abcdefghijklmnop
# SR_SMTP_FROM=du@gmail.com
# Zum Testen: alle Mails an diese Adresse statt an die Mitarbeiter (Demo-Adressen sind erfunden)
# SR_SMTP_REDIRECT_TO=du@gmail.com

# ---------------------------------------------------------------------------
# Nur für SR_MODE=graph – App-Registrierung in Microsoft Entra ID
# ---------------------------------------------------------------------------
# SR_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# SR_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# delegated (empfohlen): Backend meldet sich einmal als Empfangs-Konto an
#   (Dashboard → "Mit Microsoft anmelden"). In der App-Registrierung:
#   Authentifizierung → "Öffentliche Clientflows zulassen" = Ja
#   API-Berechtigungen (delegiert): User.Read, User.ReadBasic.All, Calendars.ReadWrite,
#   Chat.Create, ChatMessage.Send, Mail.Send
# app: Anwendungsberechtigungen + Client-Secret (Admin-Consent):
#   User.Read.All, Calendars.ReadWrite, Mail.Send
# SR_GRAPH_AUTH=delegated
# SR_GRAPH_CLIENT_SECRET=
# SR_GRAPH_SENDER=empfang@firma.de

# Reihenfolge der Benachrichtigungskanäle (teams, workflow, email)
# SR_NOTIFY_CHANNELS=teams,email
# Optional: Teams-Workflow-URL ("Wenn eine Teams-Webhookanforderung empfangen wird")
# SR_TEAMS_WORKFLOW_URL=
# Optional: nur Mitglieder dieser Entra-Gruppe sind wählbar
# SR_EMPLOYEE_GROUP_ID=
