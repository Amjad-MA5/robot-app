# Vorlage: nach .env kopieren und anpassen  (cp .env.example .env)

# Gemeinsamer Schlüssel mit der Roboter-App (App-Einstellungen → "API-Key")
SR_API_KEY=hinterland-demo

# mock  = Demo-Mitarbeiter/Kalender
# graph = echtes Microsoft 365 über MS Graph
SR_MODE=mock
SR_COMPANY_NAME=Hinterland Hack
SR_TIMEZONE=Europe/Berlin

# Language of notifications sent to employees: en | de
# SR_LANGUAGE=en

# Packages: leave_at_desk | wait_for_recipient (courier is escorted to the waiting room)
# SR_DELIVERY_HANDLING=leave_at_desk
# Remind the recipient about uncollected packages after X minutes (0 = off)
# SR_PACKAGE_REMINDER_MIN=120

# Optional SMTP email delivery. Without an SMTP host, messages stay simulated
# in the backend dashboard. Keep credentials in environment/secrets, not Git.
# Gmail example: smtp.gmail.com, port 587, STARTTLS.
# Use an app password if your provider requires one; never use a shared password here.
# Local test server without real delivery (SR_SMTP_SECURITY=none, no username/password):
#   .venv/bin/pip install aiosmtpd && .venv/bin/python -u -m aiosmtpd -n -l localhost:1025
#   then SR_SMTP_HOST=localhost, SR_SMTP_PORT=1025, SR_SMTP_FROM=robot@example.com
# SR_SMTP_HOST=smtp.gmail.com
# SR_SMTP_PORT=587
# SR_SMTP_SECURITY=starttls
# SMTP credentials require TLS (starttls or ssl).
# SR_SMTP_USERNAME=
# SR_SMTP_PASSWORD=
# SR_SMTP_FROM=

# Arbeitszeiten für Terminvorschläge (im mock-Modus standardmäßig täglich 08–20 Uhr)
# SR_WORK_DAYS=1,2,3,4,5
# SR_WORK_START=09:00
# SR_WORK_END=17:00
# SR_SLOT_MINUTES=30
# SR_SEARCH_DAYS=10
# SR_MAX_SLOTS=3

# ---------------------------------------------------------------------------
# Microsoft Graph – App registration in Microsoft Entra ID (directory/calendar only)
# ---------------------------------------------------------------------------
# SR_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
# SR_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# delegated: Backend signs in for directory/calendar access
#   (Dashboard → "Mit Microsoft anmelden"). In the app registration:
#   Authentifizierung → "Öffentliche Clientflows zulassen" = Ja
#   Delegated API permissions: User.Read, User.ReadBasic.All, Calendars.ReadWrite
# app: Application permissions + client secret (admin consent):
#   User.Read.All, Calendars.ReadWrite
# SR_GRAPH_AUTH=delegated
# SR_GRAPH_CLIENT_SECRET=

# Optional: nur Mitglieder dieser Entra-Gruppe sind wählbar
# SR_EMPLOYEE_GROUP_ID=

# ---------------------------------------------------------------------------
# Visitor badge with photo, name, ID and QR code
# ---------------------------------------------------------------------------
# The robot app normally sends the badge to the printer itself (it is in the office network,
# a cloud backend is not). These settings are only used when the backend prints itself.
# Print methods in this order: ipp (straight to the printer), ftp, mock (dashboard only), off
# SR_PRINTER_METHODS=ipp
# Konica Minolta bizhub: IPP runs over plain HTTP (port 80) at /ipp
# SR_PRINTER_URL=http://192.168.0.233/ipp
# SR_PRINT_COLOR=color
# Only for SR_PRINTER_METHODS=ftp:
# SR_PRINTER_FTP_HOST=192.168.0.233
# SR_PRINTER_FTP_USER=anonymous
# SR_PRINTER_FTP_PASSWORD=
# Validity in hours (at most until midnight) - afterwards all data is deleted
# SR_BADGE_VALID_HOURS=8
# Zones a visitor badge is valid for (access check via QR code)
# SR_BADGE_ZONES=Reception,Waiting room,Meeting rooms
# Address for the QR code, if phones reach the backend under a different address
# SR_PUBLIC_URL=http://192.168.0.50:8080
